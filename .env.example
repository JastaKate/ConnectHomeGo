# Local development only. Export these variables or set them in GoLand.
# The application does not automatically load this file.
DB_HOST=localhost
DB_PORT=5432
DB_USER=connect_home
DB_PASSWORD=postgres
DB_NAME=connect_home
DB_SSLMODE=disable

DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_MAX_CONN_LIFETIME=30m
DB_CONN_TIMEOUT=5s

# Alternatively, DATABASE_URL overrides the connection fields above.
# Goose CLI also uses this URL in the README commands.
# DATABASE_URL=postgres://connect_home:postgres@localhost:5432/connect_home?sslmode=disable
